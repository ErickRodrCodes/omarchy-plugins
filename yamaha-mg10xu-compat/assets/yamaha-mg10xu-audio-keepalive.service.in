[Unit]
# Managed by io.github.tbogard.yamaha-mg-xu
Description=Keep Yamaha MG-XU USB audio clock active
After=pipewire.service wireplumber.service
Wants=pipewire.service wireplumber.service

[Service]
Type=simple
ExecStart=/usr/bin/pw-record --target @YAMAHA_SOURCE@ --rate 48000 --channels 2 --format s16 /dev/null
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=default.target
