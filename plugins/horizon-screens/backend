#!/usr/bin/env python3
import json
import os
import re
from pathlib import Path
import runpy
import subprocess
import sys

ROOT = Path(__file__).resolve().parent
SCRIPT = ROOT / 'recovery/fix-horizon-screens'
CONFIG = Path(os.environ.get('XDG_STATE_HOME', str(Path.home() / '.local/state'))) / 'horizon-screens/launchers.json'
USER_APPS = Path.home() / '.local/share/applications'
SYSTEM_APPS = Path('/usr/share/applications')


def launcher_paths():
    if CONFIG.exists():
        return json.loads(CONFIG.read_text())
    candidates = {p.name: p for p in SYSTEM_APPS.glob('*.desktop')}
    candidates.update({p.name: p for p in USER_APPS.glob('*.desktop')})
    return [str(p) for p in candidates.values() if any(line.startswith('Exec=') and ('horizon-client' in line or 'horizon-display-layout' in line) for line in p.read_text(errors='replace').splitlines())]


def validate_launchers(paths):
    result = []
    names = set()
    for item in paths:
        p = Path(item).expanduser()
        if p.parent not in (USER_APPS, SYSTEM_APPS) or p.suffix != '.desktop' or not p.is_file():
            raise RuntimeError('Choose existing .desktop files in ~/.local/share/applications or /usr/share/applications.')
        if p.name in names:
            raise RuntimeError('Select only one source for each shortcut filename.')
        commands = [line for line in p.read_text().splitlines() if line.startswith('Exec=')]
        direct = r'^Exec=(?:env GDK_SCALE=1 )?(?:/usr/bin/)?horizon-client(?=\s|$)'
        wrapper = str(Path.home() / '.config/omarchy/plugins/io.github.tbogard.horizon-display-layout/scripts/horizon-display-layout')
        def recognized(line):
            return bool(re.match(direct, line)) or line.startswith('Exec=env GDK_SCALE=1 ' + wrapper + ' launch') or line.startswith('Exec=env GDK_SCALE=1 "' + wrapper + '" launch')
        if not commands or not all(recognized(line) for line in commands):
            raise RuntimeError(f'{p.name} does not contain a recognized Horizon command. Use the displayed command to configure this custom shortcut manually.')
        names.add(p.name)
        result.append(str(p))
    return result



def status():
    module = runpy.run_path(str(SCRIPT), run_name='recovery_backend')
    windows = module['clients']()
    running = bool(module['running_horizon_pids']() or windows)
    monitors = json.loads(module['run']('hyprctl', '-j', 'monitors'))
    details = '\n'.join(f"{m['description']}: {m['width']}×{m['height']} at {m['x']},{m['y']}" for m in sorted(monitors, key=lambda m: (m['x'], m['y'])))
    try:
        x, y, width, height = module['geometry'](monitors)
    except RuntimeError as exc:
        return dict(ok=True, running=running, canAlign=False, aligned=False, summary=str(exc), details=details)
    candidates = [w for w in windows if w.get('mapped') and w.get('floating') and not w.get('fullscreen') and w['size'] == [width, height]]
    can_align = len(candidates) == 1
    input_ok, input_message = module['input_layout']()
    can_align = can_align and input_ok
    details += '\n' + input_message
    if can_align:
        session_ok, session_message = module['session_layout'](candidates[0]['pid'])
        details += '\n' + session_message
        can_align = can_align and session_ok
    aligned = can_align and candidates[0]['at'] == [x, y]
    summary = 'Window is aligned' if aligned else ('Window needs alignment' if can_align else ('Select All Screens in Horizon' if running else 'Horizon is closed'))
    if candidates and input_ok and not can_align:
        summary = 'Reconnect Horizon with the current display arrangement'
    if not input_ok:
        summary = 'Input layout needs repair — quit Horizon first' if running else 'Input layout needs repair'
    if can_align:
        details += f"\nHorizon: {width}×{height} at {candidates[0]['at'][0]},{candidates[0]['at'][1]}"
    return dict(ok=True, running=running, canAlign=can_align, aligned=aligned, summary=summary, details=details)


def main():
    action = sys.argv[1] if len(sys.argv) >= 2 else ''
    if action == 'status':
        result = status()
        result['launchers'] = launcher_paths()
        result['launcherCommand'] = 'env GDK_SCALE=1 "' + str(Path.home() / '.config/omarchy/plugins/io.github.tbogard.horizon-display-layout/scripts/horizon-display-layout') + '" launch %u'
        return result
    if action == 'save-launchers':
        paths = validate_launchers(json.loads(sys.argv[2]))
        CONFIG.parent.mkdir(parents=True, exist_ok=True)
        temporary = CONFIG.with_suffix('.tmp')
        temporary.write_text(json.dumps(paths, indent=2) + '\n')
        temporary.replace(CONFIG)
        return dict(ok=True, message='Shortcut selection saved. No launcher files changed.')
    if action in ('repair-input', 'undo-input'):
        operation = 'enable' if action == 'repair-input' else 'disable'
        result = subprocess.run([sys.executable, str(ROOT/'native/control.py'), operation], text=True, capture_output=True)
        return dict(ok=result.returncode == 0, message='\n'.join(s.strip() for s in [result.stdout, result.stderr] if s.strip()))
    if action not in ('fix', 'verify', 'restore'):
        raise RuntimeError('Expected status, fix, verify, or restore')
    # The recovery process checks session state again at click time.
    env = os.environ.copy()
    if action == 'restore':
        if not CONFIG.exists():
            raise RuntimeError('Review and save the launcher selection before Restore.')
        env['HORIZON_RECOVERY_LAUNCHERS'] = json.dumps(validate_launchers(launcher_paths()))
    result = subprocess.run([str(SCRIPT), action], text=True, capture_output=True, env=env)
    return dict(ok=result.returncode == 0, message='\n'.join(s.strip() for s in [result.stdout, result.stderr] if s.strip()))


if __name__ == '__main__':
    try:
        print(json.dumps(main()))
    except Exception as exc:
        print(json.dumps(dict(ok=False, running=True, canAlign=False, aligned=False, summary='Unable to check screens', message=str(exc))))
        sys.exit(1)
