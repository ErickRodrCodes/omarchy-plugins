#!/usr/bin/env python3
"""Install this Omarchy plugin only after Horizon has fully closed."""
from pathlib import Path
import datetime
import runpy
import shutil
import subprocess
import sys

root=Path(__file__).resolve().parent
try:
    recovery=runpy.run_path(str(root/'recovery/fix-horizon-screens'),run_name='installer_guard')
    recovery['require_horizon_closed']()
    target=Path.home()/'.config/omarchy/plugins/io.github.tbogard.horizon-screens'
    if root == target:
        raise RuntimeError('Run install from the workspace source directory, not the installed copy.')
    if target.exists():
        backup=Path.home()/'.local/state/horizon-screens/install-backups'/datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f')
        backup.parent.mkdir(parents=True,exist_ok=True)
        shutil.copytree(target,backup)
        print(f'Previous plugin backed up: {backup}')
    shutil.copytree(root,target,dirs_exist_ok=True,ignore=shutil.ignore_patterns('__pycache__','backups'))
    compatibility = target.parent / 'io.github.tbogard.horizon-display-layout'
    if compatibility.exists():
        compat_backup = Path.home()/'.local/state/horizon-screens/install-backups'/('compatibility-' + datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f'))
        shutil.copytree(compatibility, compat_backup)
    shutil.copytree(root/'recovery/plugin', compatibility, dirs_exist_ok=True, ignore=shutil.ignore_patterns('__pycache__','backups'))
    subprocess.run(['omarchy-shell','shell','rescanPlugins'],check=True)
    subprocess.run(['omarchy','plugin','enable','io.github.tbogard.horizon-screens','--section','right'],check=True)
    print('Installed Horizon Screens in the right bar. Open its icon to check screens and review launcher shortcuts.')
except (RuntimeError,OSError,subprocess.CalledProcessError) as exc:
    print(f'Installation stopped: {exc}',file=sys.stderr)
    sys.exit(1)
