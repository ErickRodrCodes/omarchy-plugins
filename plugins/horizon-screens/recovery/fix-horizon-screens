#!/usr/bin/env python3
"""Recover the Omarchy/Horizon monitor layout without closing VDI."""
import argparse
import datetime
import json
import os
from pathlib import Path
import re
import runpy
import shutil
import subprocess
import sys

ROOT = Path(__file__).resolve().parent
PLUGIN = Path.home() / '.config/omarchy/plugins/io.github.tbogard.horizon-display-layout'
HELPER = PLUGIN / 'scripts/horizon-display-layout'
APPS = Path.home() / '.local/share/applications'


def run(*args):
    return subprocess.check_output(args, text=True).strip()


def geometry(monitors):
    return runpy.run_path(str(ROOT / 'input_layout.py'))['geometry'](monitors)


def displays():
    monitors = json.loads(run('hyprctl', '-j', 'monitors'))
    bounds = geometry(monitors)
    for m in sorted(monitors, key=lambda m: (m['x'], m['y'])):
        print(f"{m['name']}: {m['description']} — {m['width']}x{m['height']} at {m['x']},{m['y']}")
    print('Required window: %sx%s at %s,%s' % (bounds[2], bounds[3], bounds[0], bounds[1]))
    return bounds


def clients():
    return [c for c in json.loads(run('hyprctl', '-j', 'clients')) if c.get('class', '').lower() == 'horizon-client']


def input_layout():
    compare = runpy.run_path(str(ROOT / "input_layout.py"))["compare"]
    return compare(json.loads(run("hyprctl", "-j", "monitors")), run("xrandr", "--query"))


def session_layout(pid):
    model = runpy.run_path(str(ROOT / 'input_layout.py'))
    current = model['signature'](json.loads(run('hyprctl', '-j', 'monitors')))
    try:
        entries = (Path('/proc') / str(pid) / 'environ').read_bytes().split(b'\0')
    except OSError:
        return False, 'Cannot verify the Horizon launch layout. Reconnect through the updated launcher.'
    expected = ('HORIZON_LAYOUT_SIGNATURE=' + current).encode()
    if expected not in entries:
        return False, 'Display arrangement changed or launch layout is unknown. Fully quit and reopen Horizon through the updated launcher.'
    return True, 'Horizon was launched with the current display arrangement.'


def fix(dry_run=False):
    x, y, width, height = displays()
    windows = [c for c in clients() if c.get('mapped') and c.get('floating') and c['size'] == [width, height] and not c.get('fullscreen')]
    if len(windows) != 1:
        raise RuntimeError('Expected exactly one floating Horizon window spanning all screens. Select Horizon Full Screen → All Screens; if Super+F constrained it to one monitor, toggle that off. Then retry. No window changed.')
    window = windows[0]
    address = window['address']
    if not re.fullmatch(r'0x[0-9a-fA-F]+', address):
        raise RuntimeError('Unexpected window address')
    input_ok, input_message = input_layout()
    if not input_ok:
        raise RuntimeError(input_message + " No window moved: alignment alone cannot repair mouse mapping.")
    session_ok, session_message = session_layout(window['pid'])
    if not session_ok:
        raise RuntimeError(session_message)
    print(f"Window {address}: {window['at']} → [{x}, {y}]")
    if dry_run:
        print('Dry run: no changes.')
        return
    if window['at'] != [x, y]:
        # On this Lua Hyprland build x/y are ABSOLUTE, not relative deltas.
        result = run('hyprctl', 'dispatch', f'hl.dsp.window.move({{ window = "address:{address}", x = {x}, y = {y} }})')
        if result != 'ok':
            raise RuntimeError(result)
    updated = next((c for c in clients() if c['address'] == address), None)
    if not updated or updated['at'] != [x, y] or updated['size'] != [width, height]:
        raise RuntimeError('Window placement did not match after dispatch; inspect Horizon before retrying.')
    print('Verified: spanning window aligned and XWayland display coordinates agree. Confirm content and pointer alignment visually on all active displays.')


def running_horizon_pids():
    # --monitors-list can interact with an existing client and recreate its
    # render window. Plugin hot reloads can also run setup during a session.
    running = []
    for proc in Path('/proc').iterdir():
        if not proc.name.isdigit():
            continue
        try:
            if proc.stat().st_uid == os.getuid() and (proc / 'comm').read_text().strip() in ('horizon-client', 'horizon-protoco', 'horizon-protocol'):
                running.append(proc.name)
        except (FileNotFoundError, ProcessLookupError):
            continue
        except PermissionError:
            continue
    return running


def require_horizon_closed():
    if running_horizon_pids() or clients():
        raise RuntimeError('Fully quit Horizon before restore, verify, or input-layout changes. These operations can disturb a running session. Use fix for live alignment; status is read-only.')


def restore():
    require_horizon_closed()
    displays()
    for command in ['cc', 'jq', 'xrandr', 'horizon-client', 'update-desktop-database']:
        if not shutil.which(command):
            raise RuntimeError(f'Missing required command: {command}. No restore files changed.')
    backup = ROOT / 'backups' / datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f')
    backup.mkdir(parents=True)
    if PLUGIN.exists():
        shutil.copytree(PLUGIN, backup / 'plugin')
    PLUGIN.parent.mkdir(parents=True, exist_ok=True)
    shutil.copytree(ROOT / 'plugin', PLUGIN, dirs_exist_ok=True)
    # Force a rebuild after package updates, without replacing a mapped .so in place.
    state = Path(os.environ.get('XDG_STATE_HOME', str(Path.home() / '.local/state'))) / 'horizon-display-layout'
    state.mkdir(parents=True, exist_ok=True)
    library = state / 'libhorizon-display-layout.so'
    if library.exists():
        shutil.copy2(library, backup / library.name)
    temporary = state / 'libhorizon-display-layout.rebuild.so'
    subprocess.run(['cc', '-shared', '-fPIC', '-O2', '-Wall', '-Wextra', '-o', str(temporary), str(PLUGIN / 'src/horizon-display-layout.c'), '-ldl'], check=True)
    temporary.replace(state / 'libhorizon-display-layout.so')
    print(run(str(HELPER), 'verify'))
    APPS.mkdir(parents=True, exist_ok=True)
    selected = os.environ.get('HORIZON_RECOVERY_LAUNCHERS')
    if selected is not None:
        candidates = {Path(p).name: Path(p) for p in json.loads(selected)}
    else:
        candidates = {p.name: p for p in APPS.glob('*.desktop')}
        candidates.setdefault('horizon-client.desktop', Path('/usr/share/applications/horizon-client.desktop'))
    for name, source in candidates.items():
        text = source.read_text()
        changed = False
        lines = []
        for line in text.splitlines():
            match = re.match(r'^Exec=(?:env GDK_SCALE=1 )?(?:/usr/bin/)?horizon-client(?=\s|$)(.*)$', line)
            if match:
                line = f'Exec=env GDK_SCALE=1 "{HELPER}" launch{match.group(1)}'
                changed = True
            lines.append(line)
        if changed:
            shutil.copy2(source, backup / name)
            (APPS / name).write_text('\n'.join(lines) + '\n')
    subprocess.run(['update-desktop-database', str(APPS)], check=True)
    print(f'Backups: {backup}')
    print('Restored launch fix. Open Horizon, select All Screens, then run this script with fix.')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', nargs='?', choices=['fix', 'status', 'restore', 'verify'], default='fix')
    parser.add_argument('--dry-run', action='store_true', help='Preview window alignment (fix only)')
    args = parser.parse_args()
    if args.dry_run and args.action != 'fix':
        parser.error('--dry-run is supported only with fix')
    if args.action == 'fix':
        fix(args.dry_run)
    elif args.action == 'restore':
        restore()
    elif args.action == 'verify':
        require_horizon_closed()
        displays()
        print(run(str(HELPER), 'verify'))
    else:
        displays()
        print(run('xrandr', '--listmonitors'))
        for c in clients():
            print({k: c[k] for k in ['address', 'at', 'size', 'fullscreen', 'pid']})


if __name__ == '__main__':
    try:
        main()
    except (RuntimeError, OSError, subprocess.CalledProcessError) as exc:
        print(f'Recovery stopped: {exc}', file=sys.stderr)
        sys.exit(1)
