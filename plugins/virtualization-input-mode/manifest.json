{
  "schemaVersion": 1,
  "id": "io.github.tbogard.virtualization-input-mode",
  "name": "Virtualization Input Mode",
  "version": "0.2.1",
  "author": "Erick Rodriguez",
  "license": "MIT",
  "description": "Pass Omarchy desktop shortcuts through to virtual machines, VDIs, and remote desktop clients.",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "keepLoaded": true,
  "omarchy": {
    "testedVersion": "4.0.1-1"
  },
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Virtualization Input Mode",
    "description": "Toggle whether Omarchy or a guest application receives desktop shortcuts.",
    "category": "System",
    "aliases": [
      "virtualization",
      "vm",
      "remote-desktop",
      "horizon",
      "omnissa",
      "vdi",
      "input",
      "keybinds"
    ],
    "allowMultiple": false,
    "defaultSection": "right"
  }
}
