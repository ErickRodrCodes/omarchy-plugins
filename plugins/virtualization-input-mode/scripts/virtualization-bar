#!/usr/bin/env bash
set -euo pipefail

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/virtualization-input-mode"
marker="$state_dir/virtualization-hid-bar"
log_file="$state_dir/activity.log"

log_event() {
  mkdir -p "$state_dir"
  printf '%s  %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$log_file"
}

case "${1:-}" in
  restore)
    if [[ -f "$marker" ]]; then
      omarchy toggle bar off
      rm -f "$marker"
      log_event "virtualization bar guard: restored"
    fi
    ;;
  *)
    echo "Usage: virtualization-bar {restore}" >&2
    exit 2
    ;;
esac
